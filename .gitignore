# Logs
logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage
.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons
build/Release

# Dependency directories
node_modules
jspm_packages

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Next.js
.next
out/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# TypeScript
*.tsbuildinfo

# Blog drafts and their images: shown by `npm run dev`, never committed, so they
# reach neither GitHub nor the live site (see docs/blog-posts.md). The README
# keeps the drafts folder in place.
src/content/drafts/*
!src/content/drafts/README.md
public/drafts/

# The Python environment for drawing plots for posts (see docs/blog-posts.md)
.venv/

# Auxiliary files kept out of the site, such as the scripts that draw the plots in
# posts (see docs/blog-posts.md)
aux/

# The local Node.js of scripts/dev-env.sh, and the notes for the next working session
.node/
HANDOFF.md
